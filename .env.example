# Canonical site origin (no trailing slash). Used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.jorireland.com

# Optional: JSON endpoint for enquiry-form submissions (e.g. https://formspree.io/f/xxxxxxx).
# Leave empty to use the email-app fallback. See docs/CONTACT-INTEGRATION.md.
NEXT_PUBLIC_FORM_ENDPOINT=
